  "sections": [
    {
      "title": "परिभाषाएँ",
      "type": "block",
      "items": [
        {
          "heading": "विशेषण",
          "lines": [
            "जो शब्द संज्ञा या सर्वनाम की विशेषता बताते हैं उन्हें विशेषण कहते हैं।",
            "जैसे: अच्छा, बुरा, पाँच मीटर, ऊँचा, मोटा, बूढ़ा, गरीब, युवा",
            "विशेष्य: जिन शब्दों की विशेषता बताई जाती है, उन्हें विशेष्य कहते हैं।"
          ],
          "sources": {
            "notes": true
          }
        },
        {
          "heading": "सर्वनाम",
          "lines": [
            "संज्ञा के स्थान पर आने वाले शब्द सर्वनाम कहलाते हैं।",
            "जैसे: मैं, हम, तुम, आप, मेरा आदि।",
            "संज्ञा शब्दों की तरह सर्वनाम शब्दों में भी एकवचन-बहुवचन होते हैं।",
            "एकवचन → बहुवचन: मैं → हम, मेरा → हमारा, उसे → उन्हें, इसका → इनका, उसका → उनका",
            "आदर प्रकट करने के लिए बहुवचन रूप का प्रयोग होता है।"
          ],
          "sources": {
            "notes": true
          }
        },
        {
          "heading": "लिंग",
          "lines": [
            "शब्द के जिस रूप से यह पता चले कि वह स्त्री जाति का है या पुरुष जाति का, उसे लिंग कहते हैं।",
            "लिंग के दो भेद हैं: पुल्लिंग और स्त्रीलिंग।",
            "पुल्लिंग: जो संज्ञा शब्द पुरुष जाति का बोध कराते हैं। जैसे: नाना, दादा, मोर आदि।",
            "स्त्रीलिंग: जो संज्ञा शब्द स्त्री जाति का बोध कराते हैं। जैसे: नानी, दादी, मोरनी आदि।"
          ],
          "sources": {
            "notes": true
          }
        },
        {
          "heading": "वचन",
          "lines": [
            "शब्द के जिस रूप से उसके एक या एक से अधिक होने का पता चलता है, उसे वचन कहते हैं।",
            "एकवचन: जिस रूप से एक होने का पता चलता है। जैसे: बच्चा, लड़की आदि।",
            "बहुवचन: जिस रूप से एक से अधिक होने का पता चलता है। जैसे: बच्चे, लड़कियाँ, किताबें आदि।",
            "वचन हमें संख्या बताते हैं। 'पानी' सदा एकवचन में और 'आँसू' सदा बहुवचन में प्रयोग होता है।"
          ],
          "sources": {
            "notes": true
          }
        },
        {
          "heading": "अशुद्धि-शोधन",
          "lines": [
            "गलत लिखे या बोले हुए शब्दों/वाक्यों को सही करना अशुद्धि-शोधन कहलाता है।"
          ],
          "sources": {
            "notes": true
          }
        }
      ]
