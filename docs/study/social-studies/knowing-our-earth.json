      "title": "Define",
      "type": "qa",
      "items": [
        {
          "question": "Map",
          "answer": "It is a drawing of places on a flat surface that shows the location of countries, states and cities.",
          "sources": {
            "notes": true
          }
        },
        {
          "question": "Globe",
          "answer": "It is a small, round model of earth. It shows the countries, oceans and seas.",
          "sources": {
            "notes": true
          }
        },
        {
          "question": "Atlas",
          "answer": "It is a book of maps. It is easy to carry than a globe.",
          "sources": {
            "notes": true
          }
        }
      ],
      "layout": "terms"
