        {
          "word": "charged",
          "meaning": "rushed forward with force or attack",
          "example": "The soldiers charged at the enemy.",
          "sources": {
            "notes": true
          }
        },
        {
          "word": "tempting",
          "meaning": "attractive, something that makes you interested",
          "example": "The smell of freshly baked pizza is so tempting.",
          "sources": {
            "notes": true
          }
        },
        {
          "word": "pounce",
          "meaning": "to jump over something or someone suddenly",
          "example": "The eagle pounced from the sky to catch a fish.",
          "sources": {
            "notes": true
          }
        },
        {
          "word": "deserved",
          "meaning": "earned something by working hard",
          "example": "He deserved a break after such a long day.",
          "sources": {
            "notes": true
          }
        }
