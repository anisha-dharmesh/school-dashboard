    {
      "title": "Comprehension Questions",
      "type": "qa",
      "items": [
        {
          "question": "What caught Ronnie's attention one day?",
          "answer": "Ronnie's attention was caught by a huge house and a big basket full of chocolates with a pink bow at the gate.",
          "sources": {
            "notes": true,
            "textbook": true
          }
        },
        {
          "question": "Why did the guard call Ronnie an ill-mannered child?",
          "answer": "The guard called Ronnie an ill-mannered child because Ronnie had initially charged at the gate and shouted, showing impolite behaviour.",
          "sources": {
            "notes": true,
            "textbook": true
          }
        },
        {
          "question": "'No one can turn me away now.' Why did Ronnie think so?",
          "answer": "Ronnie thought that no one could turn him away because he had taken a bath, combed his hair and wanted to avoid making any more mistakes in order to be well-mannered.",
          "sources": {
            "notes": true,
            "textbook": true
          }
        },
        {
          "question": "Why did the tall man send Ronnie away?",
          "answer": "The tall man sent Ronnie away because Ronnie had failed to use the word 'please' when asking for the basket, showing a lack of manner.",
          "sources": {
            "notes": true,
            "textbook": true
          }
        },
        {
          "question": "Do you think Ronnie deserved the basket? Why/Why not?",
          "answer": "Yes, Ronnie deserved the basket because he learned important lessons about manners & politeness.",
          "sources": {
            "notes": true,
            "textbook": true
          }
        }
      ]
    },
