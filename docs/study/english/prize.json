      "title": "Being Polite: Good or Bad Manners",
      "type": "trueFalse",
      "items": [
        {
          "statement": "Saying “May I?” is good manners.",
          "answer": true,
          "sources": {
            "textbook": true
          }
        },
        {
          "statement": "Making fun of others is good manners.",
          "answer": false,
          "explanation": "Making fun of others is bad manners.",
          "sources": {
            "textbook": true
          }
        },
        {
          "statement": "Teasing is good manners.",
          "answer": false,
          "explanation": "Teasing is bad manners.",
          "sources": {
            "textbook": true
          }
        },
        {
          "statement": "Making noise is good manners.",
          "answer": false,
          "explanation": "Making noise is bad manners.",
          "sources": {
            "textbook": true
          }
        },
        {
          "statement": "Saying “Thank you!” is good manners.",
          "answer": true,
          "sources": {
            "textbook": true
          }
        },
        {
          "statement": "Saying “Please!” is good manners.",
          "answer": true,
          "sources": {
            "textbook": true
          }
        }
