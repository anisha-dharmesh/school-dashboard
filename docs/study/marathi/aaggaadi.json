        {
          "question": "आगगाडी कशी चालत होती?",
          "answer": "आगगाडी झुक-झुक आवाज करत चालत होती.",
          "sources": {
            "textbook": true
          }
        },
        {
          "question": "आगगाडीच्या डब्यात इकडून तिकडे कोण फिरत होते?",
          "answer": "आगगाडीच्या डब्यातून वस्तू विकणारे, चहावाले इकडून तिकडे फिरत होते.",
          "sources": {
            "textbook": true
          }
        },
        {
          "question": "मावशी कोठे राहते?",
          "answer": "मावशी कोकणात राहते.",
          "sources": {
            "notes": true
          }
        },
        {
          "question": "आगगाडीतून काय दिसत होते?",
          "answer": "हिरवीगार शेते, नारळाच्या बागा, गर्द आमराई, लाल माती, हिरवे डोंगर हे सर्व आगगाडीतून दिसत होते.",
          "sources": {
            "notes": true
          }
        },
        {
          "question": "मावशीने केव्हा राहायला बोलावले?",
          "answer": "मावशीने दिवाळीच्या सुट्टीत राहायला बोलावले.",
          "sources": {
            "notes": true
          }
        },
        {
          "question": "रेल्वेच्या डब्यात सर्वजण काय करत होते?",
          "answer": "रेल्वेच्या डब्यात काही प्रवासी पुस्तक वाचत होते, काही गाणी ऐकत होते तर काही झोपले होते.",
          "sources": {
            "notes": true
          }
        }
