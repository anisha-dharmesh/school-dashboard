          "question": "सशाचा रंग कोणता आहे?",
          "answer": "सशाचा रंग पांढरा आहे.",
          "sources": {
            "textbook": true
          }
        },
        {
          "question": "चाहूल लागताच ससा कुठे लपतो?",
          "answer": "चाहूल लागताच ससा झाडाझुडपात लपतो.",
          "sources": {
            "textbook": true
          }
        },
        {
          "question": "सशाचे डोळे कसे आहेत?",
          "answer": "सशाचे डोळे लाल-लाल छान आहेत.",
          "sources": {
            "textbook": true
          }
        },
        {
          "question": "सशाचे कान कसे आहेत?",
          "answer": "सशाचे कान मोठे मोठे आहेत.",
          "sources": {
            "textbook": true
          }
        },
        {
          "question": "सशाची चाल कशी आहे?",
          "answer": "सशाची चाल तुरुतुरु आहे.",
          "sources": {
            "textbook": true
          }
        }
