    {
      "title": "Answer the Following Questions",
      "type": "qa",
      "items": [
        {
          "question": "What is the Artist lab?",
          "answer": "The Artist lab on code.org is a fun, creative space where we can draw pictures by writing code.",
          "sources": {
            "notes": true
          }
        },
        {
          "question": "How do coding blocks help us?",
          "answer": "Coding blocks tell the computer how to draw.",
          "sources": {
            "notes": true
          }
        },
        {
          "question": "What can the Artist do?",
          "answer": "The Artist can move in different directions, draw lines, turn angles and change colours.",
          "sources": {
            "notes": true
          }
        },
        {
          "question": "What does the \"move\" block do?",
          "answer": "The \"move\" block makes the Artist move forward or backward by a specified number of pixels.",
          "sources": {
            "notes": true
          }
        }
      ]
    },
