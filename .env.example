# ERP (SNBP Wagholi). main.py now calls the ERP's own JSON API directly
# (the same one the School App uses) instead of logging into the ASP.NET
# site and scraping HTML -- see scraper/notices.py. That API takes the
# child's StudentId/AcademicYearId as plain query params and needs no
# login, so ERP_USERNAME/ERP_PASSWORD are no longer used by the pipeline
# (kept below only for scraper/login.py, which still works standalone if
# something ever needs an authenticated ASP.NET session again).
ERP_BASE_URL=https://wagholierp.snbpinstitutes.in
ERP_STUDENT_ID=
ERP_ACADEMIC_YEAR_ID=
# The class/section's own id (III F = 430), used only by the Daily Class
# Update fetch (GetDailyWork.php) -- see scraper/daily_work.py.
ERP_CLASS_SECTION_ID=
# Other sections of the same class, as student:section pairs -- their
# Notes/Study notices fill gaps in ours (scraper/gap_fill.py). Additive only.
ERP_EXTRA_STUDENTS=
ERP_USERNAME=
ERP_PASSWORD=

# Google Calendar sync (calendar_sync.py) -- pushes Exam/Test, Holiday and
# School Event notices onto the calendar the dashboard's "Subscribe on
# Calendar" button links to. Authenticates as a service account (no browser
# / OAuth consent flow, since this runs unattended): create one in Google
# Cloud Console, enable the Calendar API, and share the calendar below with
# the service account's email as "Make changes to events". Paste its JSON
# key here as one line. Optional -- notices still sync fine without it.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=c037f4d74892f557ed740b1d2410e6bb1efcab224ddd95ad45d1e486bc8a85e5@group.calendar.google.com
GOOGLE_DRIVE_FOLDER_ID=
